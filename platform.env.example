# Copy to platform.env (git-ignored by the `*.env` rule).
# Values below are placeholders. Never commit the filled-in file.

# HMAC key of the signal bus: >= 32 bytes, identical for the bridge and every worker. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
NOTHIERLY_ZMQ_SECRET=

# Hyperliquid worker. The agent wallet signs orders and cannot withdraw. HL_AGENT_SECRET is only read with --live.
HL_ACCOUNT_ADDRESS=
HL_AGENT_SECRET=
HL_VAULT_ADDRESS=

# Bybit worker. Keys must NOT have the Withdraw permission (the worker refuses them if they do).
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Alertes push sur les urgences opérationnelles des workers (homme mort, drawdown, pannes d'API répétées). Optionnel.
# Discord : https://discord.com/api/webhooks/<id>/<token>
# Telegram : https://api.telegram.org/bot<token>/sendMessage?chat_id=<chat_id>
# Doit être en https ; l'URL contient un jeton : ne jamais la commiter ni la coller dans un ticket.
WEBHOOK_URL=
