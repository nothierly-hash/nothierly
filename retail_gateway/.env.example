# Retail Gateway environment template -- copy to .env.retail at the repo root (used by
# docker-compose.retail.yml's `env_file: .env.retail`) or to retail_gateway/.env for local
# `uvicorn retail_gateway.main:app --reload` runs. Deliberately separate from the trading core's
# own .env -- see docker-compose.retail.yml's module comment.

RETAIL_DB_HOST=127.0.0.1
RETAIL_DB_PORT=5433
RETAIL_DB_DATABASE=retail_gateway
RETAIL_DB_USER=retail_gateway
RETAIL_DB_PASSWORD=

RETAIL_REDIS_HOST=127.0.0.1
RETAIL_REDIS_PORT=6380
RETAIL_REDIS_PASSWORD=

# Required -- no default. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
RETAIL_JWT_SECRET_KEY=
RETAIL_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

RETAIL_RATE_LIMIT_SIGNUP_PER_HOUR_PER_IP=5
RETAIL_RATE_LIMIT_LOGIN_PER_MINUTE_PER_IP=10

# console (default, logs only) | resend | ses (not yet implemented -- see email_provider.py)
RETAIL_EMAIL_PROVIDER=console
RETAIL_EMAIL_RESEND_API_KEY=
RETAIL_EMAIL_FROM_ADDRESS=welcome@nothierly.example
