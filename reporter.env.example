# Copy to reporter.env (git-ignored by the `*.env` rule). Used ONLY by nothierly-position-reporter.
# Deliberately separate from platform.env: this service must never receive a trading key.

# Hyperliquid: positions of an address are public, no secret needed. Same address as the worker's HL_ACCOUNT_ADDRESS (and HL_VAULT_ADDRESS for a vault).
HL_ACCOUNT_ADDRESS=
HL_VAULT_ADDRESS=

# Bybit / Binance: create SEPARATE API keys with READ-ONLY permission (no trading, no withdrawal). Never put the trading keys here.
BYBIT_READONLY_API_KEY=
BYBIT_READONLY_API_SECRET=
BINANCE_READONLY_API_KEY=
BINANCE_READONLY_API_SECRET=
