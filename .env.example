# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Multi-tenant Docker deployment (docker-compose.yml) -------------------
# Required by every service's ${CLIENT_ID:?...} guard in docker-compose.yml --
# a stack refuses to start without it, rather than silently launching
# unattributed. Also used as this client's own Compose project name (see
# docker-compose.yml's header comment): `docker compose -p nothierly-${CLIENT_ID}
# --env-file .env.<this client> up -d`.
CLIENT_ID=
# Real password protection on this client's own internal Redis broker
# (redis-broker's --requirepass) -- required, docker-compose.yml refuses to
# start redis-broker without it. Distinct from the optional REDIS_PASSWORD
# below only in that the Docker template makes it mandatory; the setting
# itself is the same core.config.RedisSettings.password field either way.
# REDIS_PASSWORD=
# Host ports for the two services actually exposed outside the cluster.
# Change these if running more than one client's stack on the same Docker
# host.
GATEWAY_HOST_PORT=8000
DASHBOARD_HOST_PORT=8503
# Which .env file docker-compose.yml's env_file: directives load per
# service. Defaults to this file's own name (.env) -- override per client,
# e.g. CLIENT_ENV_FILE=.env.client_alpha, when running several clients'
# stacks from the same docker-compose.yml on one host.
# CLIENT_ENV_FILE=.env

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
SERVICE_NAME=trading-engine
# MOCK_MODE=true (the default -- safe by default): ExecutionAgent logs
# the order it would have placed instead of calling OANDA at all.
# Independent of OANDA_ENVIRONMENT below: MOCK_MODE governs whether the
# broker is called *at all*, not which of its own environments is
# called. Must be explicitly set to false to place any real order.
MOCK_MODE=true

# --- Dashboard authentication (bootstraps the real IAM admin account) ------
# Either unset means every login attempt is refused -- there is no
# "no password configured" bypass. Read once per process start by
# core.iam.IamStore.ensure_bootstrap_admin (see src/dashboard/
# nothierly_ems.py) to create/migrate the initial admin account into the
# real IAM store (core/iam.py) -- a real per-user account from then on,
# not a live-read shared password (see that module's own docstring).
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Redis -------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_USE_TLS=false

# --- ZeroMQ inter-agent bus ------------------------------------------------
# ZMQ_PUB_ADDRESS/ZMQ_SUB_ADDRESS: used only when NO broker is configured
# below -- one agent binding its own port and talking to itself (every
# standalone demo/test in this project, e.g. `python main_test.py`).
ZMQ_PUB_ADDRESS=tcp://127.0.0.1:5555
ZMQ_SUB_ADDRESS=tcp://127.0.0.1:5556
# ZMQ_BROKER_FRONTEND_ADDRESS/ZMQ_BROKER_BACKEND_ADDRESS: required by
# scripts/run_backend.py (multiple agents sharing one process -- see
# core/zmq_broker.py). Leave both empty for standalone single-agent use;
# set both (e.g. tcp://127.0.0.1:5559 / tcp://127.0.0.1:5560) to run the
# full multi-agent backend, as docker-compose.yml already does.
ZMQ_BROKER_FRONTEND_ADDRESS=
ZMQ_BROKER_BACKEND_ADDRESS=
# ZMQ_BROKER_BIND_FRONTEND_ADDRESS/ZMQ_BROKER_BIND_BACKEND_ADDRESS: optional, only needed for a
# multi-CONTAINER deployment (see docker-compose.yml's alpha-engine service). Leave both empty for a
# plain local/single-process run -- the broker then binds the same address agents connect to above,
# the original, still-default behavior. When set, the broker BINDS these instead (typically a
# 0.0.0.0 wildcard, reachable from other containers) while every agent -- including a separate
# container's -- still CONNECTS via ZMQ_BROKER_FRONTEND_ADDRESS/_BACKEND_ADDRESS above (0.0.0.0 is
# only ever a valid bind target, never a valid connect target).
ZMQ_BROKER_BIND_FRONTEND_ADDRESS=
ZMQ_BROKER_BIND_BACKEND_ADDRESS=
ZMQ_HIGH_WATER_MARK=1000

# --- Broker / exchange API (required, no default) --------------------------
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_BASE_URL=https://api.broker.example.com

# --- Security Vault (required, no default) -- encrypts per-exchange broker
# credentials added at runtime via the Liquidity Routing dashboard page
# (src/execution/security_vault.py). Any passphrase; stretched into a real
# Fernet key via PBKDF2-HMAC-SHA256. Changing this after credentials have
# already been encrypted makes them undecryptable -- treat it like any other
# production secret (rotate deliberately, not casually).
VAULT_MASTER_KEY=

# --- OANDA forex broker (required, no default) -- SupervisorAgent's live
# order-execution connector. `environment` defaults to 'practice' (paper
# trading, no real funds); must be set to 'live' explicitly for real money.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# --- Vast.ai GPU rental (optional -- only scripts/run_remote_training.py
# uses this, never a live agent) ---------------------------------------------
VASTAI_API_KEY=
VASTAI_SSH_PUBLIC_KEY_PATH=
VASTAI_SSH_PRIVATE_KEY_PATH=

# --- Macro / on-chain data providers (optional -- MacroAgent falls back to
# simulated readings for any indicator whose key is left empty) ------------
MACRO_FRED_API_KEY=
MACRO_GLASSNODE_API_KEY=

# --- Financial news provider (optional -- NlpAgent falls back to a
# simulated headline feed when left empty) ----------------------------------
NEWS_API_KEY=

# --- TimescaleDB (ArchivistAgent + src/data_pipeline) -----------------------
# Two ways to configure the same connection -- see core.config.
# TimescaleSettings.connection_url: DATABASE_URL, if set, wins outright;
# otherwise the TIMESCALE_* fields below are composed into one. Plain
# `python -m src.data_pipeline...` runs (outside Docker) typically want
# the TIMESCALE_* fields pointed at 127.0.0.1; docker-compose.yml's
# `backend` service overrides TIMESCALE_HOST to `timescaledb` itself, so
# these values here are what a non-Docker run on your own machine uses.
TIMESCALE_HOST=127.0.0.1
TIMESCALE_PORT=5432
TIMESCALE_DATABASE=market_data
TIMESCALE_USER=nothierly_admin
TIMESCALE_PASSWORD=
# DB_USER/DB_PASSWORD: consumed directly by docker-compose.yml's
# `timescaledb` service (POSTGRES_USER/POSTGRES_PASSWORD) -- keep these
# equal to TIMESCALE_USER/TIMESCALE_PASSWORD above, or the container's
# actual credentials and this process's connection attempt will disagree.
DB_USER=nothierly_admin
DB_PASSWORD=
# DATABASE_URL: optional full connection string, overriding every
# TIMESCALE_* field above when set (e.g. for docker-compose.yml's
# `backend` service, or any deployment that prefers one string over five
# separate fields). Left empty here since TIMESCALE_*/DB_* above already
# fully describe the same connection -- setting both is redundant, not
# wrong (DATABASE_URL simply wins), but pick one style per environment
# rather than maintaining two sources of truth for the same value.
DATABASE_URL=

# --- Guardian AI / Chief Risk Officer (optional -- src/agents/guardian_ai.py
# falls back to a deterministic, template-based risk assessment when left
# unconfigured, rather than skipping the safety check). GUARDIAN_LLM_PROVIDER
# must be 'openai' or 'anthropic' (with GUARDIAN_API_KEY set) to actually
# call an LLM; 'none' (the default) always uses the fallback.
GUARDIAN_LLM_PROVIDER=none
GUARDIAN_API_KEY=
GUARDIAN_MODEL=

# --- Cloudflare R2 data lake (optional -- src/data_pipeline/data_lake_sync.py
# raises DataLakeConfigurationError if a download is attempted without these
# set; nothing else in this project touches R2, so leaving these blank is
# safe if you're not doing offline backtesting/training with R2-hosted
# historical data). AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY use those exact
# (unprefixed) names deliberately -- that's what Cloudflare's own R2 dashboard
# calls them, since R2's API is S3-compatible. Example values below are
# fake -- replace with the real ones from your Cloudflare dashboard.
R2_ACCOUNT_ID=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4
R2_BUCKET_NAME=nothierly-market-data
AWS_ACCESS_KEY_ID=0123456789abcdef0123456789abcdef
AWS_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd

# --- B2B Execution Middleware (api_middleware/gateway.py) -- required to
# accept any request: unset means every X-API-Key is rejected (fails
# closed, not open). Comma-separated for multiple clients. Example value
# below is fake -- replace with real, randomly generated per-client keys.
API_MIDDLEWARE_API_KEYS=client-alpha-9f2e1a7b,client-beta-4c8d2f61
API_MIDDLEWARE_RATE_LIMIT_PER_MINUTE=60
# Unset by default -- no CORSMiddleware installed, API stays server-to-server-
# only. Set only once a real browser-based client needs to call this API
# directly (comma-separated origins, e.g. https://app.example.com).
# API_MIDDLEWARE_CORS_ALLOWED_ORIGINS=

# --- EOD Reconciliation (src/execution/eod_reconciliator.py) -- unset means
# no brokers are reconciled (fails closed, same convention as API_MIDDLEWARE_
# API_KEYS above), not a guessed default broker list.
# RECONCILIATION_BROKER_IDS=binance,oanda,ibkr
RECONCILIATION_BREAK_THRESHOLD_USD=50.0

# --- FIX 4.4 order-entry gateway (api_middleware/fix_server.py) ------------
# FIX_ALLOWED_CLIENT_SENDER_COMP_IDS unset means every Logon is rejected
# (fails closed), same convention as API_MIDDLEWARE_API_KEYS above.
FIX_HOST=127.0.0.1
FIX_PORT=5001
FIX_OUR_COMP_ID=NOTHIERLY
# FIX_ALLOWED_CLIENT_SENDER_COMP_IDS=client-alpha-fix,client-beta-fix
FIX_HEARTBEAT_INTERVAL_SECONDS=30

# --- Red Phone SMS circuit breaker (src/agents/alert_agent.py) -- optional:
# unconfigured means send_sms_alert logs and skips (the agent still trips
# the real Kill Switch and EMERGENCY_HALT broadcast either way, it just
# can't SMS anyone). ADMIN_PHONE_NUMBER is deliberately NOT prefixed
# TWILIO_ -- that's the brief's own literal env var name. Example values
# below are fake -- replace with real values from your Twilio console.
TWILIO_ACCOUNT_SID=ACa1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4
TWILIO_AUTH_TOKEN=0123456789abcdef0123456789abcdef
TWILIO_PHONE_NUMBER=+15550001234
ADMIN_PHONE_NUMBER=+15559998765

# --- Alpha Engine Telegram push alerts (core/notifier.py) -- optional:
# unconfigured means TelegramNotifier.send logs and skips (the engine's
# own safety logic -- inventory cap, staleness check, Kill Switch -- is
# entirely independent of whether this is set; a missing notifier never
# changes trading behavior, only whether a human gets paged about it).
# bot_token from @BotFather; chat_id is the destination chat/user/channel
# ID (send a message to your bot, then GET
# https://api.telegram.org/bot<token>/getUpdates to find it).
TELEGRAM_BOT_TOKEN=0123456789:AAfake-example-token-not-real
TELEGRAM_CHAT_ID=123456789

# --- Monthly billing reports (src/execution/reporting_engine.py) -- optional:
# unconfigured means send_report_email logs and skips (the PDF is still
# generated and archived to reports/, just not emailed). Plain SMTP, not a
# provider SDK -- works against any provider's SMTP relay (SES, SendGrid, a
# real mailbox, ...) without picking one as a hard dependency.
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=apikey
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=reports@nothierly.example
