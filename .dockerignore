# Version control
.git
.gitignore

# Virtual environments
.venv
.venv_test
venv
env

# Python cache/build artifacts
__pycache__
*.pyc
*.pyo
.mypy_cache
.pytest_cache
*.egg-info

# Secrets -- never baked into an image; injected at runtime via
# docker-compose's env_file instead (see docker-compose.yml).
.env

# Local-only artifacts not needed inside the image
logs/
models/
# Real, trained artifacts the Dockerfile explicitly COPYs by name (see its own comment next to
# those two COPY lines) -- re-included here despite the blanket models/ exclusion above, the same
# negation pattern .gitignore already uses for models/.gitkeep.
!models/supervisor_model_20260910_010746.json
!models/supervisor_scaler_20260910_010746.pkl
.claude/
